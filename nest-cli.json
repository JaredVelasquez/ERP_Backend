{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "compilerOptions": {
    "deleteOutDir": true
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json",
        "webpack": true
      }
    },
    "identity": {
      "type": "application",
      "root": "apps/identity",
      "entryFile": "main",
      "sourceRoot": "apps/identity/src",
      "compilerOptions": {
        "tsConfigPath": "apps/identity/tsconfig.app.json",
        "webpack": true
      }
    },
    "erp": {
      "type": "application",
      "root": "apps/erp",
      "entryFile": "main",
      "sourceRoot": "apps/erp/src",
      "compilerOptions": {
        "tsConfigPath": "apps/erp/tsconfig.app.json",
        "webpack": true
      }
    },
    "mcps": {
      "type": "application",
      "root": "apps/mcps",
      "entryFile": "main",
      "sourceRoot": "apps/mcps/src",
      "compilerOptions": {
        "tsConfigPath": "apps/mcps/tsconfig.app.json",
        "webpack": true
      }
    },
    "domain": {
      "type": "library",
      "root": "libs/domain",
      "entryFile": "index",
      "sourceRoot": "libs/domain/src",
      "compilerOptions": {
        "tsConfigPath": "libs/domain/tsconfig.lib.json"
      }
    },
    "application": {
      "type": "library",
      "root": "libs/application",
      "entryFile": "index",
      "sourceRoot": "libs/application/src",
      "compilerOptions": {
        "tsConfigPath": "libs/application/tsconfig.lib.json"
      }
    },
    "infrastructure": {
      "type": "library",
      "root": "libs/infrastructure",
      "entryFile": "index",
      "sourceRoot": "libs/infrastructure/src",
      "compilerOptions": {
        "tsConfigPath": "libs/infrastructure/tsconfig.lib.json"
      }
    },
    "presentation": {
      "type": "library",
      "root": "libs/presentation",
      "entryFile": "index",
      "sourceRoot": "libs/presentation/src",
      "compilerOptions": {
        "tsConfigPath": "libs/presentation/tsconfig.lib.json"
      }
    }
  }
}
