{
  "name": "michelle-market-erp",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Michelle Market ERP — inventory, accounting, and documents",
  "scripts": {
    "build": "npm run build:gateway && npm run build:identity && npm run build:erp && npm run build:mcps",
    "build:gateway": "nest build gateway",
    "build:identity": "nest build identity",
    "build:erp": "nest build erp",
    "build:mcps": "nest build mcps",
    "start:gateway": "nest start gateway",
    "start:identity": "nest start identity",
    "start:erp": "nest start erp",
    "start:mcps": "nest start mcps",
    "dev:identity": "nest start identity --watch",
    "dev:erp": "nest start erp --watch",
    "dev:mcps": "nest start mcps --watch",
    "dev:gateway": "nest start gateway --watch",
    "dev": "concurrently -n identity,erp,mcps,gateway -c blue,green,yellow,magenta \"npm:dev:identity\" \"npm:dev:erp\" \"npm:dev:mcps\" \"npm:dev:gateway\"",
    "migrate:postgres": "ts-node -r tsconfig-paths/register scripts/run-postgres-migrations.ts",
    "db:ensure": "ts-node -r tsconfig-paths/register scripts/create-postgres-database.ts",
    "db:status": "ts-node -r tsconfig-paths/register scripts/check-postgres-state.ts",
    "storage:ensure-bucket": "ts-node -r tsconfig-paths/register scripts/ensure-s3-bucket.ts",
    "smoke:auth-refresh": "ts-node -r tsconfig-paths/register scripts/smoke-refresh-session.ts",
    "smoke:auth-http": "ts-node -r tsconfig-paths/register scripts/smoke-auth-http.ts",
    "smoke:assistant-history": "ts-node -r tsconfig-paths/register scripts/smoke-assistant-history.ts",
    "smoke:assistant-page": "ts-node -r tsconfig-paths/register scripts/smoke-assistant-page.ts",
    "smoke:s3": "ts-node -r tsconfig-paths/register scripts/smoke-s3-storage.ts",
    "smoke:postgres": "ts-node -r tsconfig-paths/register scripts/smoke-postgres.ts",
    "smoke:postgres:write": "ts-node -r tsconfig-paths/register scripts/smoke-postgres-write.ts",
    "smoke:import-idempotency": "ts-node -r tsconfig-paths/register scripts/smoke-import-idempotency.ts",
    "smoke:auth-browser": "ts-node -r tsconfig-paths/register scripts/smoke-browser-refresh.ts",
    "smoke:voucher-storage-http": "ts-node -r tsconfig-paths/register scripts/smoke-voucher-storage-http.ts",
    "smoke:frontend-mobile-routes": "ts-node -r tsconfig-paths/register scripts/smoke-frontend-mobile-routes.ts",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --max-warnings 0",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "http-proxy-middleware": "^3.0.7",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.16.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@domain/(.*)$": "<rootDir>/libs/domain/src/$1",
      "^@application/(.*)$": "<rootDir>/libs/application/src/$1",
      "^@infrastructure/(.*)$": "<rootDir>/libs/infrastructure/src/$1",
      "^@presentation/(.*)$": "<rootDir>/libs/presentation/src/$1",
      "^@composition/(.*)$": "<rootDir>/apps/modules/$1"
    }
  }
}
