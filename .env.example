GATEWAY_PORT=3000
IDENTITY_PORT=3001
ERP_PORT=3002
MCPS_PORT=3003

IDENTITY_URL=http://127.0.0.1:3001
ERP_URL=http://127.0.0.1:3002
MCPS_URL=http://127.0.0.1:3003

PG_HOST=localhost
PG_PORT=5432
PG_NAME=erp_dev
PG_USER=erp_app
PG_PASSWORD=
PG_MIGRATION_USER=erp_owner
PG_MIGRATION_PASSWORD=
PG_SSL=false
PG_BOOTSTRAP_USER=
PG_BOOTSTRAP_PASSWORD=
PG_ALLOW_CREATE_DATABASE=false

# Web sessions: short access tokens and rotating refresh tokens.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Temporary compatibility window for sessions created before refresh-token migration.
LEGACY_SESSION_UNTIL=
WEB_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175

# Private S3 compatible storage (Cloudflare R2 in development).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=erp
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_VOUCHER_PREFIX=comprobantes
# Object keys use: S3_VOUCHER_PREFIX/voucherId/filename

# Assistant: choose openai, gemini, or anthropic; company settings override these defaults.
ERP_AI_PROVIDER=gemini
ERP_AI_MODEL=gemini-2.5-flash
ERP_AI_API_KEY=
# Required to encrypt per-company AI keys at rest. Use a unique random secret (32+ characters).
ERP_AI_ENCRYPTION_KEY=
